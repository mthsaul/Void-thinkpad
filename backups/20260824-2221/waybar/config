{
  "layer": "top",
  "position": "top",
  "height": 30,
  "modules-left": ["custom/rofi"],
  "modules-center": [
    "ext/workspaces",
    "custom/omniroute",
    "cpu",
    "memory",
    "pulseaudio",
    "network",
    "custom/battery",
    "clock",
    "custom/power"
  ],
  "modules-right": [],
  "cpu": {
    "format": "CPU {usage}%",
    "interval": 2
  },
  "memory": {
    "format": "MEM {percentage}%",
    "interval": 5
  },
  "pulseaudio": {
    "format": "VOL {volume}%",
    "format-muted": "VOL mute",
    "scroll-step": 5
  },
  "network": {
    "format-wifi": "WIFI {essid} ({signalStrength}%)",
    "format-ethernet": "ETH {ipaddr}",
    "format-disconnected": "SIN RED",
    "interval": 5
  },
  "clock": {
    "format": "{:%a %d %b, %H:%M}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "locale": "es_PE.UTF-8",
    "interval": 60
  },
  "custom/battery": {
    "exec": "echo \"BAT $(cat /sys/class/power_supply/BAT1/capacity)%\"",
    "interval": 15
  },
  "ext/workspaces": {
    "format": "{icon}",
    "on-click": "activate"
  },
  "custom/rofi": {
    "format": "",
    "tooltip": false,
    "on-click": "~/.config/rofi/launchers/type-1/launcher.sh",
    "on-click-right": "rofi -show run"
  },
  "custom/omniroute": {
    "return-type": "json",
    "exec": "/home/void/.local/bin/waybar-omniroute status",
    "interval": 3,
    "on-click": "/home/void/.local/bin/waybar-omniroute toggle",
    "on-click-right": "/home/void/.local/bin/waybar-omniroute stop",
    "signal": 8
  },
  "custom/power": {
    "format": "power",
    "tooltip": true,
    "tooltip-format": "Apagar / Cerrar sesion",
    "on-click": "wlogout -l $HOME/.config/wlogout/layout"
  }
}
