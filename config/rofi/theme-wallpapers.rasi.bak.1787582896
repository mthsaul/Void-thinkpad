@import "colors-wallpapers.rasi"

* {
    background-color: transparent;
    text-color: @foreground;
}

window {
    width: 90%;
    background-color: @background;
    border: 2px;
    border-color: @border;
    border-radius: 12px;
    padding: 20px;
}

mainbox {
    children: [ "inputbar", "listview" ];
    spacing: 15px;
}

inputbar {
    background-color: @input-bg;
    text-color: @foreground;
    padding: 8px 12px;
    border-radius: 8px;
}

listview {
    layout: horizontal;
    columns: 6;
    lines: 8;
    spacing: 10px;
    scrollbar: false;
    fixed-height: true;
}

element {
    orientation: vertical;
    padding: 6px;
    border-radius: 10px;
}

element selected {
    background-color: @selected-bg;
    border: 2px;
    border-color: @accent;
}

element-icon {
    size: 130px;
    horizontal-align: 0.5;
    border-radius: 8px;
}

element-text {
    font: "IosevkaTerm Nerd Font 9";
    horizontal-align: 0.5;
    vertical-align: 0.5;
}
