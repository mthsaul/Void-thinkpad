{
  "layer": "top",
  "position": "top",
  "height": 30,
  "modules-left": [],
  "modules-center": [
    "ext/workspaces",
    "cpu",
    "memory",
    "pulseaudio",
    "custom/battery",
    "clock",
    
    "custom/power"
  ],
  "modules-right": [],
  "cpu": {
    "format": "CPU {usage}%",
    "interval": 2
  },
  "memory": {
    "format": "MEM {percentage}%",
    "interval": 5
  },
  "pulseaudio": {
    "format": "VOL {volume}%",
    "format-muted": "VOL mute",
    "scroll-step": 5
  },
  "clock": {
    "format": "{:%a %d %b, %H:%M}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "locale": "es_PE.UTF-8",
    "interval": 60
  },
  "custom/battery": {
    "exec": "echo \"BAT $(cat /sys/class/power_supply/BAT1/capacity)%\"",
    "interval": 15
  },
  "ext/workspaces": {
    "format": "{icon}",
    "on-click": "activate"
  },
    
  "custom/power": {
    "format": "power",
    "tooltip": true,
    "tooltip-format": "Apagar / Cerrar sesion",
    "on-click": "wlogout"
  }
}